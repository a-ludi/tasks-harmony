{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "packs", "chores", "questions", "completions", "xpSettings", "profile", "syncState"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "exportedAt": { "type": "string" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "manifest", "isPersonal", "importedAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "manifest": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "author": { "type": "string" },
              "license": { "type": "string" },
              "description": { "type": "string" },
              "revision": { "type": "string" },
              "revisionHistory": { "type": "string" },
              "cdpCreatedAt": { "type": "string" },
              "chores": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*\\.yaml$" } },
              "createdAt": { "type": "string" },
              "streak": { "type": "boolean" },
              "xpTarget": { "type": "number", "minimum": 0 },
              "targetDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "allowShiftOnImport": { "type": "boolean" },
              "decay": { "type": "boolean" },
              "defaultXPSize": { "oneOf": [{ "type": "string", "enum": ["XXS", "XS", "S", "M", "L", "XL", "XXL", "XXXL"] }, { "type": "number" }] }
            },
            "additionalProperties": false
          },
          "isPersonal": { "type": "boolean" },
          "importedAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "aliasFor": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "chores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "choreId", "packId", "title", "xpSize", "recurrence", "repeatable", "active", "createdAt"],
        "properties": {
          "key": { "type": "string" },
          "choreId": { "type": "string" },
          "packId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "xpSize": { "oneOf": [{ "type": "string", "enum": ["XXS", "XS", "S", "M", "L", "XL", "XXL", "XXXL"] }, { "type": "number" }] },
          "recurrence": {
            "type": "object",
            "required": ["frequency", "interval", "startDate", "windowStartTime"],
            "properties": {
              "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
              "interval": { "type": "integer", "minimum": 1 },
              "startDate": { "type": "string" },
              "windowStartTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
            },
            "additionalProperties": false
          },
          "repeatable": { "type": "boolean" },
          "active": { "type": "boolean" },
          "duePeriod": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number", "minimum": 0 },
              "unit": { "type": "string", "enum": ["minutes", "hours", "days", "weeks", "months"] }
            },
            "additionalProperties": false
          },
          "createdAt": { "type": "string" },
          "syncStatus": { "type": "string", "enum": ["in-sync", "out-of-sync"] }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "choreKey", "type", "prompt", "required", "order"],
        "properties": {
          "id": { "type": "string" },
          "choreKey": { "type": "string" },
          "type": { "type": "string", "enum": ["TEXT", "INTEGER", "BOOLEAN", "ENUM", "MULTIPLIER"] },
          "prompt": { "type": "string" },
          "required": { "type": "boolean" },
          "order": { "type": "integer" },
          "active": { "type": "boolean" },
          "regexPattern": { "type": "string" },
          "minValue": { "type": "number" },
          "maxValue": { "type": "number" },
          "choices": { "type": "array" },
          "xpPerUnit": { "type": "number" },
          "multiplierAnswerType": { "type": "string", "enum": ["integer", "float"] }
        },
        "additionalProperties": false
      }
    },
    "completions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "choreKey", "completedAt", "xpEarned", "streak", "answers"],
        "properties": {
          "id": { "type": "string" },
          "choreKey": { "type": "string" },
          "completedAt": { "type": "string" },
          "xpEarned": { "type": "number" },
          "streak": { "type": "number" },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["questionId", "value"],
              "properties": {
                "questionId": { "type": "string" },
                "value": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "xpSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "maxStreakMultiplier", "decayFloor", "streakHalfLife", "decayHalfLife"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "maxStreakMultiplier": { "type": "number" },
          "decayFloor": { "type": "number" },
          "streakHalfLife": { "type": "number" },
          "decayHalfLife": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "displayName", "email", "activeXPSettingsId"],
      "properties": {
        "id": { "type": "string", "const": "me" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "activeXPSettingsId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "syncState": {
      "type": "object",
      "required": ["id", "pendingSync"],
      "properties": {
        "id": { "type": "string", "const": "main" },
        "pendingSync": { "type": "boolean" },
        "lastSyncedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quickAnswerSets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "choreKey", "label", "answers"],
        "properties": {
          "id": { "type": "string" },
          "choreKey": { "type": "string" },
          "label": { "type": "string" },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["questionId", "value"],
              "properties": {
                "questionId": { "type": "string" },
                "value": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
